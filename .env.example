# Токен вашего Telegram-бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Ваш личный Telegram ID (узнать можно у @userinfobot) — для доступа к /admin
ADMIN_ID=0

# Username канала, куда бот будет публиковать вакансии.
# Создайте публичный канал в Telegram, добавьте туда бота как администратора
# с правом публикации сообщений, и укажите его username здесь (с собачкой).
VACANCIES_CHANNEL=@your_channel_username

# Строка подключения к базе данных.
# По умолчанию — локальный файл SQLite, ничего менять не нужно для первого запуска.
# Для перехода на PostgreSQL в будущем достаточно заменить эту строку, например:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bot_db
DATABASE_URL=sqlite+aiosqlite:///./bot.db
