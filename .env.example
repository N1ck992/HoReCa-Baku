# Токен вашего Telegram-бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Ваш личный Telegram ID (узнать можно у @userinfobot) — для доступа к /admin
ADMIN_ID=0

# Username канала, куда бот будет публиковать вакансии.
# Создайте публичный канал в Telegram, добавьте туда бота как администратора
# с правом публикации сообщений, и укажите его username здесь (с собачкой).
VACANCIES_CHANNEL=@your_channel_username

# Строка подключения к базе данных.
# Вариант 1 — локальный файл SQLite (для разработки на своём компьютере):
# DATABASE_URL=sqlite+aiosqlite:///./bot.db
# Вариант 2 — PostgreSQL на Supabase (для боевого запуска), формат строго такой,
# со вставкой "+asyncpg" после "postgresql" — без этого бот не запустится:
# DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:пароль@aws-0-xxxxx.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Ссылка на веб-сайт с тестами (Mini App), размещённый на Netlify.
# Если не заполнить — бот покажет старое текстовое меню выбора должности.
WEBAPP_URL=https://genuine-babka-85a14a.netlify.app
