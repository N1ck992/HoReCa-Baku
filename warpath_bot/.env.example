# Токен бота от @BotFather. Никогда не коммитьте настоящий токен.
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Путь к файлу SQLite. На хостинге укажите путь на постоянном диске (volume),
# например /data/warpath.db
DATABASE_PATH=data/runtime/warpath.db

# Показывать ли пользователям ТЕСТОВЫЕ билды (с пометкой 🧪). Только для разработки!
SHOW_TEST_DATA=false

# Лимит поисков в сутки для бесплатного тарифа (0 = без лимита)
FREE_DAILY_SEARCH_LIMIT=50

# Порт HTTP health-check (/health). Пусто = health-сервер не запускается.
# На Render/Railway можно указать ${PORT}.
HEALTH_PORT=

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
